{
  "name": "gamehearth-mau-mau",
  "version": "0.3.0",
  "private": true,
  "description": "Mau-Mau für 2–6 Spieler, das erste Spiel für Gamehearth",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build --config client/vite.config.ts --logLevel warn",
    "dev:client": "vite --config client/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "check": "gamehearth check .",
    "pack": "npm run build && gamehearth pack ."
  },
  "dependencies": {
    "@gamehearth/sdk": "file:vendor/gamehearth-sdk-0.1.4.tgz",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gamehearth": "file:vendor/gamehearth-0.6.0.tgz",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@gamehearth/sdk": "$@gamehearth/sdk"
  }
}
