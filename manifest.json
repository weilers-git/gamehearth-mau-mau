{
  "id": "mau-mau",
  "name": "Mau-Mau",
  "version": "0.3.0",
  "sdk": "^0.1.4",
  "license": {
    "code": "MIT",
    "assets": "CC0-1.0"
  },
  "mode": "turn-based",
  "players": {
    "min": 2,
    "max": 6
  },
  "server": true,
  "client": "dist/client",
  "description": "Mau-Mau für 2–6 Spieler mit Siebenern, Achtern, Buben und Assen",
  "stats": {
    "siege": {
      "label": "Siege",
      "better": "higher"
    }
  },
  "repository": "https://github.com/weilers-git/gamehearth-mau-mau",
  "roles": {
    "player": {
      "inputs": [
        "touch",
        "mouse"
      ],
      "screen": "small"
    }
  },
  "options": {
    "bubeAufBube": {
      "label": "Bube auf Bube",
      "type": "boolean",
      "default": false
    },
    "siebenerStapeln": {
      "label": "7er stapeln",
      "type": "boolean",
      "default": true
    },
    "ass": {
      "label": "Ass",
      "type": "choice",
      "default": "nochmal",
      "choices": [
        {
          "value": "nochmal",
          "label": "noch mal dran"
        },
        {
          "value": "aussetzen",
          "label": "Nächster setzt aus"
        }
      ]
    }
  }
}
